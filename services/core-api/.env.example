PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://admin:secretpassword@localhost:5432/tixpulse_db?schema=public"

# Cache & Distributed Locking (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Message Broker (RabbitMQ)
RABBITMQ_URI=amqp://admin:secretpassword@localhost:5672

# JWT Auth
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Throttler (Rate Limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

